# ============================================
# Application
# ============================================
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# Database — Prisma/PostgreSQL
# ============================================
# Maps to: secret/data/subscription-service/{env}/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db
DB_POOL_SIZE=20

# ============================================
# Redis — Sessions, rate limiting, queues
# ============================================
# Maps to: secret/data/subscription-service/{env}/redis
REDIS_URL=redis://:@localhost:6379

# ============================================
# Auth — JWT signing
# ============================================
# Maps to: secret/data/subscription-service/{env}/auth
JWT_SECRET=your-jwt-secret-key-min-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Payment Gateway — Stripe
# ============================================
# Maps to: secret/data/subscription-service/{env}/gateways
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Encryption — for tenant credentials
# ============================================
# Maps to: secret/data/subscription-service/shared/encryption-key
ENCRYPTION_KEY=your-32-byte-base64-encoded-key