# ============================================
# Application
# ============================================
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# ============================================
# Database — Prisma/PostgreSQL
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db
DB_POOL_SIZE=20

# ============================================
# Redis — Sessions, rate limiting, queues
# ============================================
REDIS_URL=redis://:@localhost:6379

# ============================================
# Auth — JWT signing
# (Loaded but verification skipped in dev via SKIP_AUTH)
# ============================================
JWT_SECRET=your-jwt-secret-key-min-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Dev auth bypass
# ============================================
# When true AND NODE_ENV != production, plans/subscriptions routes
# skip JWT verification and require only X-Tenant-Id header.
SKIP_AUTH=true

# ============================================
# Payment Gateway — Stripe
# ============================================
# Override per-request via checkout/provider fields on Subscription,
# or fall back to DEFAULT_PAYMENT_PROVIDER when none is supplied.
DEFAULT_PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Encryption — for tenant credentials
# ============================================
ENCRYPTION_KEY=your-32-byte-base64-encoded-key
