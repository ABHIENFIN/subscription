// Prisma schema for Subscription Microservice
// Multi-tenant model with RBAC, plans, plan_prices, subscriptions, and payment tracking.
// Plan model follows Approach A: one Product (per tier) holds many Prices (one per cadence).
// Legacy fields on Plan (amount/currency/interval/gatewayPlanId) are kept for backwards
// compatibility with rows created under the Approach B prototype.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PLANS (the marketing tier / product concept)
// ============================================
model Plan {
  id          String     @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  productId   String? // Stripe prod_... shared across this plan's prices
  features    Json? // Per-tier entitlement blob (doc §12.6)
  status      PlanStatus @default(DRAFT)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // --- legacy fields (Approach B prototype) — kept for back-compat only ---
  amount          Decimal?         @db.Decimal(10, 2)
  currency        String?          @default("USD")
  interval        BillingInterval?
  intervalCount   Int?
  trialDays       Int?
  gatewayPlanId   String? // Legacy: was a Stripe price_... under Approach B
  gatewaySyncedAt DateTime?

  prices        PlanPrice[]
  subscriptions Subscription[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@map("plans")
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

// ============================================
// PLAN PRICES (one Stripe price_... per cadence/feature)
// Multiple prices live under one Plan (Approach A).
// ============================================
model PlanPrice {
  id              String           @id @default(uuid())
  planId          String
  plan            Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  gatewayPriceId  String? // Stripe price_... once published
  amount          Int // smallest currency unit (cents)
  currency        String           @default("USD")
  interval        BillingInterval?
  intervalCount   Int              @default(1)
  type            PriceType        @default(RECURRING)
  usageType       UsageType        @default(LICENSED)
  trialDays       Int              @default(0)
  nickname        String? // "monthly", "yearly", "setup", "per_call" — display only
  status          PriceStatus      @default(DRAFT)
  gatewaySyncedAt DateTime?
  isActive        Boolean          @default(true)

  // --- USD snapshot (immutable, captured at create/publish) ---
  // Display uses `amount` + `currency` (the user's original price, e.g. ₹299).
  // Reporting uses `amountUsdCents` (the USD cents equivalent at capture time).
  // FX fields are write-once; never recomputed.
  amountUsdCents Int? // USD amount in cents (smallest unit). NULL only for legacy rows.
  fxRate         Decimal?  @db.Decimal(18, 8) // foreign-per-USD (e.g. 83.50 INR per 1 USD). 1.0 for USD.
  fxAsOf         DateTime? // When the FX rate was captured
  fxSource       String? // "stripe" | "manual" — origin of the rate

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@map("plan_prices")
}

enum PriceType {
  RECURRING
  ONE_TIME
}

enum UsageType {
  LICENSED
  METERED
}

enum PriceStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ============================================
// SUBSCRIPTIONS
// ============================================
model Subscription {
  id                    String             @id @default(uuid())
  tenantId              String
  userId                String
  planId                String
  plan                  Plan               @relation(fields: [planId], references: [id])
  planPriceId           String? // Primary recurring price (Approach A)
  addons                String[]           @default([]) // Additional planPriceIds (one-time setup fees, etc.)
  status                SubscriptionStatus @default(ACTIVE)
  gatewayProvider       String // 'stripe', 'paypal', etc.
  gatewaySubscriptionId String? // Provider-side ID
  gatewayCustomerId     String?
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  cancelledAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  invoices Invoice[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  PAUSED
  EXPIRED
}

// ============================================
// INVOICES
// ============================================
model Invoice {
  id               String        @id @default(uuid())
  tenantId         String
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  status           InvoiceStatus @default(PENDING)
  gatewayInvoiceId String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  VOID
}
